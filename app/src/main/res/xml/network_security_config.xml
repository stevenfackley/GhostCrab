<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP must stay enabled platform-wide because the primary use case is
    a LAN gateway on an RFC-1918 address, and Android NSC cannot express CIDR
    ranges. The public-IP restriction is enforced at runtime instead:
    data/api/CleartextPublicIpInterceptor rejects http:// to any non-private IP
    literal unless the user opts in via Settings → Security. The UI additionally
    shows amber (HTTP) / crimson (HTTP + no auth) banners.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
