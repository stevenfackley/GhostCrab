<?xml version="1.0" encoding="utf-8"?>
<!--
    API < 31 backup rules. Nothing is backed up: the token store is bound to an
    AndroidKeyStore master key that never leaves the device, so a restored copy
    would be undecryptable anyway, and profile URLs identify the user's gateway.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
