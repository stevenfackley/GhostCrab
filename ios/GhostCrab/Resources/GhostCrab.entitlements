<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Generated by xcodegen from ios/project.yml (targets.GhostCrab.entitlements.properties).
         Edit the keys there: a key only in this file is dropped on the next generate. -->

    <!-- Shared with iOS: Keychain access -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.qavren.ghostcrab</string>
    </array>

    <!-- Mac Catalyst: App Sandbox is required for Mac App Store / TestFlight -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound TCP/UDP — gateway HTTP requests and Bonjour browsing/resolving.
         The app never listens or advertises a service, so no network.server. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
